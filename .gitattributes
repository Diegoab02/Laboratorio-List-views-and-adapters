# El repositorio se trabaja desde Windows y desde un shell Linux a la vez.
# Sin esto, cada cambio de entorno marca todos los archivos como modificados
# solo por el fin de linea, y el diff real queda enterrado.
* text=auto eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

*.png  binary
*.jpg  binary
*.pdf  binary
*.xlsx binary
*.jar  binary
