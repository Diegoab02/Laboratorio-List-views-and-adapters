          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/courses/{{course_id}}/assignments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tipo invalido de prueba\",\n  \"statement\": \"Enunciado suficientemente largo para pasar la validacion de longitud.\",\n  \"type\": \"VIDEO\",\n  \"maxScore\": 100,\n  \"dueOffsetDays\": 7\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
