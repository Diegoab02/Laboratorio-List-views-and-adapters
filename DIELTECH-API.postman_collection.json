    {
      "name": "Tareas practicas (HU-37 / HU-38)",
      "description": "Ejercicios practicos por modulo. Las pruebas negativas son las que importan: el enunciado sin compra, el instructor ajeno y la entrega ya calificada. Si alguna de esas devuelve 200, la regla no esta en el servidor.",
      "item": [
        {
          "name": "1. Listar tareas del curso (sin sesion)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/assignments",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "Sin token la cadena de seguridad responde 401, no 403: el cliente tiene que poder distinguir 'inicia sesion' de 'no tienes permiso'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 sin sesion, no 403', () => pm.response.to.have.status(401));",
                  "pm.test('el cuerpo trae mensaje legible', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar tareas del curso (autenticado)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/assignments",
            "header": [],
            "description": "Con sesion pero sin compra el enunciado llega en null y locked = true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const a = pm.response.json();",
                  "pm.test('devuelve una lista', () => pm.expect(a).to.be.an('array'));",
                  "if (a.length) { pm.collectionVariables.set('assignment_id', a[0].id); }",
                  "pm.test('si esta bloqueada el enunciado no viaja', () => {",
                  "  a.filter(x => x.locked).forEach(x => pm.expect(x.statement).to.equal(null));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Mis tareas del curso con estado de entrega",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courses/{{course_id}}/assignments/mine",
            "header": [],
            "description": "Un solo viaje: tarea, mi entrega, si puedo entregar y por que no."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const v = pm.response.json();",
                  "pm.test('cada fila trae canSubmit', () => v.forEach(x => pm.expect(x).to.have.property('canSubmit')));",
                  "pm.test('si no puede entregar, dice por que', () => {",
                  "  v.filter(x => !x.canSubmit).forEach(x => pm.expect(x.blockedReason).to.be.a('string'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Detalle de una tarea con mi entrega",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/assignments/{{assignment_id}}/mine",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('trae la tarea', () => pm.expect(pm.response.json()).to.have.property('assignment'));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Guardar borrador",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/assignments/{{assignment_id}}/submission",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Voy a medias, guardo para seguir luego.\",\n  \"draft\": true\n}"
            },
            "description": "Guardar borrador reutiliza la misma fila. Repetir esta peticion no debe crear una segunda entrega."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 o 403 si el modulo no esta completo', () => pm.expect([200,403]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const s = pm.response.json();",
                  "  pm.test('queda en DRAFT', () => pm.expect(s.status).to.equal('DRAFT'));",
                  "  pm.test('un borrador no tiene fecha de entrega', () => pm.expect(s.submittedAt).to.equal(null));",
                  "  pm.collectionVariables.set('submission_id', s.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Entrega definitiva",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/assignments/{{assignment_id}}/submission",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Entrega final del ejercicio, con la salida de consola incluida.\",\n  \"draft\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, 403 o 409', () => pm.expect([200,403,409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const s = pm.response.json();",
                  "  pm.test('queda en SUBMITTED', () => pm.expect(s.status).to.equal('SUBMITTED'));",
                  "  pm.test('tiene fecha de entrega', () => pm.expect(s.submittedAt).to.not.equal(null));",
                  "  pm.test('conserva el mismo id que el borrador', () => {",
                  "    const prev = pm.collectionVariables.get('submission_id');",
                  "    if (prev) pm.expect(String(s.id)).to.equal(String(prev));",
                  "  });",
                  "}",
                  "if (pm.response.code === 409) {",
                  "  pm.test('ya calificada: no admite cambios', () => pm.expect(pm.response.json().message).to.include('calificada'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Entrega vacia (debe fallar)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/assignments/{{assignment_id}}/submission",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"   \",\n  \"draft\": true\n}"
            },
            "description": "Bean Validation en el DTO. Devuelve 400 con el mapa campo -> error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('dice que campo fallo', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Tarea inexistente (debe fallar)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/assignments/999999/mine",
            "header": [],
            "description": "Antes de este sprint esto devolvia 400. Ahora 404, que es lo que es."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404, no 400', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. ADMIN: listar tareas del curso",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/courses/{{course_id}}/assignments",
            "header": [],
            "description": "Requiere rol INSTRUCTOR o ADMIN. Si el instructor no es dueño del curso, 403 desde el servicio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 si eres dueño, 403 si no', () => pm.expect([200,403]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const a = pm.response.json();",
                  "  pm.test('el admin si ve el enunciado', () => a.forEach(x => pm.expect(x.statement).to.be.a('string')));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "10. ADMIN: crear tarea",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/courses/{{course_id}}/assignments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Ejercicio de prueba desde Postman\",\n  \"statement\": \"Escribe un programa que valide la entrada del usuario y explique el resultado.\",\n  \"type\": \"CODE\",\n  \"lessonId\": null,\n  \"maxScore\": 100,\n  \"dueOffsetDays\": 7,\n  \"orderIndex\": 0\n}"
            },
            "description": "lessonId en null crea una tarea del curso completo, que no choca con la regla de un modulo = una tarea."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 o 403', () => pm.expect([201,403]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('new_assignment_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "11. ADMIN: titulo invalido (debe fallar)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/admin/courses/{{course_id}}/assignments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ab\",\n  \"statement\": \"corto\",\n  \"type\": \"CODE\",\n  \"maxScore\": 100,\n  \"dueOffsetDays\": 7\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('nombra los campos que fallan', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.errors).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
