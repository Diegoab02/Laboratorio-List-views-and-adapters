{
  "info": {
    "name": "DIELTECH API",
    "description": "Coleccion completa de la API REST de Dieletech",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "course_id",
      "value": "1"
    },
    {
      "key": "assignment_id",
      "value": ""
    },
    {
      "key": "new_assignment_id",
      "value": ""
    },
    {
      "key": "submission_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
