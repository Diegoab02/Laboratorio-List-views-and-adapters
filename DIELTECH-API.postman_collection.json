              "raw": "{\n  \"email\": \"diego@test.com\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "4. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token guardado automaticamente');",
                  "}"
                ]
