              "mode": "raw",
              "raw": "{\n  \"name\": \"Diego Betancur\",\n  \"email\": \"diego@test.com\",\n  \"password\": \"123456\",\n  \"role\": \"STUDENT\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
